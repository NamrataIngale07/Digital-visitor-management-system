rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to validate visitor document fields
    function isValidVisitor(data) {
      return data.name is string && data.name.size() > 0 &&
             data.phone is string && data.phone.size() > 0 &&
             data.purpose is string &&
             data.department is string &&
             data.hostName is string;
    }

    // Visitors collection rules
    match /visitors/{visitorId} {
      // Allow authenticated campus staff and gate officers to read and write records
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidVisitor(request.resource.data);
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Notifications collection rules
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Users profile collection rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || request.auth.token.role == 'admin');
    }
  }
}
